{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "timezone": "Asia/Tokyo",
  "prBodyNotes": [
    "Run the `build` workflow on this branch before merging. It publishes only from `main`."
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release assets and their sha256",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\n\\w+_VERSION=(?<currentValue>\\S+)\\n\\w+_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "image-builder",
      "managerFilePatterns": [
        "/^\\.github/workflows/image\\.yml$/"
      ],
      "matchStrings": [
        "repository: (?<depName>kubernetes-sigs/image-builder)\\n\\s+ref: (?<currentDigest>[0-9a-f]{40}) # (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Kubernetes versions to publish",
      "managerFilePatterns": [
        "/^\\.github/workflows/build\\.yml$/"
      ],
      "matchStrings": [
        "- (?<currentValue>v1\\.\\d+\\.\\d+)\\n"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Ubuntu base images",
      "managerFilePatterns": [
        "/^qemu-.+\\.json$/"
      ],
      "matchStrings": [
        "\"iso_checksum\": \"(?<currentDigest>[0-9a-f]{64})\",\\s+\"iso_checksum_type\": \"sha256\",\\s+\"iso_url\": \"https://cloud-images\\.ubuntu\\.com/minimal/releases/\\w+/release-(?<currentValue>[0-9.]+)/ubuntu-(?<packageName>[0-9.]+)-minimal"
      ],
      "depNameTemplate": "ubuntu-minimal-{{packageName}}",
      "datasourceTemplate": "custom.ubuntu-minimal",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Stay on the LTS line",
      "matchDepNames": [
        "containerd/containerd"
      ],
      "allowedVersions": "/^v2\\.3\\./"
    },
    {
      "description": "Stay on the line image-builder uses",
      "matchDepNames": [
        "opencontainers/runc"
      ],
      "allowedVersions": "/^v1\\.4\\./"
    },
    {
      "description": "image-builder requires ~> 1.1.0",
      "matchDepNames": [
        "hashicorp/packer-plugin-qemu"
      ],
      "allowedVersions": "/^v1\\.1\\./"
    },
    {
      "description": "Add new Kubernetes minors by hand",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ],
  "customDatasources": {
    "ubuntu-minimal": {
      "defaultRegistryUrlTemplate": "https://cloud-images.ubuntu.com/minimal/releases/streams/v1/com.ubuntu.cloud:released:download.json",
      "transformTemplates": [
        "{\"releases\": [$each($lookup(products, 'com.ubuntu.cloud:minimal:{{packageName}}:amd64').versions, function($v, $k) { {\"version\": $k, \"digest\": $lookup($v.items, 'disk1.img').sha256} })]}"
      ]
    }
  }
}
